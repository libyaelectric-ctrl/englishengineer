{
  "name": "engvox-frontend",
  "private": true,
  "version": "4.0.22",
  "author": "Özcan ERENSAYIN",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:all": "concurrently -n \"frontend,backend\" -c \"blue,green\" \"npm run dev\" \"npm --prefix backend run dev\"",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit && cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build --configLoader runner",
    "capacitor:sync": "npx cap sync",
    "capacitor:android:build": "cd android && ./gradlew assembleRelease",
    "capacitor:android:run": "cd android && ./gradlew installDebug",
    "capacitor:android:build:release": "npx cap sync && cd android && ./gradlew assembleRelease",
    "clean": "node -e \"const fs=require('fs'); ['dist','.vite','.npm-cache','.turbo','node_modules/.cache'].forEach((p)=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}})\"",
    "clean:node": "node -e \"const fs=require('fs'); ['node_modules','package-lock.json'].forEach((p)=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}})\"",
    "reinstall": "npm run clean:node && npm install",
    "test": "vitest run --configLoader runner --reporter dot --exclude 'src/e2e/**' --exclude 'e2e/**' --exclude '.mimocode/**' --exclude 'tests/**' --exclude 'src/shared/tests/integration/**'",
    "test:integration": "vitest run --configLoader runner src/shared/tests/integration",
    "test:watch": "vitest --configLoader runner",
    "test:coverage": "vitest run --coverage --configLoader runner --exclude 'src/e2e/**' --exclude 'e2e/**' --exclude '.mimocode/**' --exclude 'tests/**' --exclude 'src/shared/tests/integration/**'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "depcruise": "depcruise src backend --config .dependency-cruiser.mjs",
    "depcruise:graph": "depcruise src backend --config .dependency-cruiser.mjs --output-type dot | dot -T svg > dependency-graph.svg",
    "e2e": "vitest run src/e2e --configLoader runner",
    "e2e:browser": "playwright test",
    "backend:install": "npm --prefix backend install --no-audit",
    "backend:test": "npm --prefix backend test",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:rls": "node scripts/verify-supabase-rls.mjs",
    "import:grammar": "node scripts/import-grammar-database.mjs",
    "import:vocabulary": "node scripts/import-vocabulary-database.mjs",
    "verify:grammar": "node scripts/verify-grammar-database.mjs",
    "verify:vocabulary": "node scripts/verify-vocabulary-database.mjs",
    "verify:test-exit": "node scripts/run-with-timeout.mjs 90000 run test",
    "verify:build-exit": "node scripts/run-with-timeout.mjs 120000 run build",
    "verify:quality-exit": "node scripts/run-with-timeout.mjs 240000 run quality:gate",
    "kademe8:verify": "node scripts/prc-kademe-8-live-verify.mjs",
    "kademe8:check": "node scripts/prc-kademe-8-live-verify.mjs --env-check",
    "quality:gate": "node scripts/quality-gate.mjs",
    "quality:gate:browser": "npm run quality:gate && npm run e2e:browser",
    "e2e:browser:install": "playwright install chromium",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "ANALYZE=true npm run build",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:licenses": "license-checker --production --csv --out licenses.csv",
    "check:licenses:reject": "license-checker --production --failOn 'GPL-3.0;AGPL-3.0'",
    "a11y:audit": "node scripts/a11y-audit.mjs",
    "content:validate": "node scripts/verify-release.mjs",
    "check:dead-code": "knip --no-progress",
    "check-languages": "node scripts/verify-language-completeness.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.1",
    "@clerk/clerk-react": "^5.61.9",
    "@sentry/react": "^10.73.0",
    "@supabase/supabase-js": "^2.114.0",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/dom": "^10.4.1",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.4",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "canvas": "^3.2.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "uuid": "^11.1.1",
    "axios": "^1.7.9"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
