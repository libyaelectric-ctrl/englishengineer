#!/bin/sh

HOOK_STARTED_AT=$(date +%s)
report_duration() {
  HOOK_FINISHED_AT=$(date +%s)
  echo "⏱️  Pre-commit completed in $((HOOK_FINISHED_AT - HOOK_STARTED_AT))s"
}
trap report_duration EXIT

npx --no-install lint-staged

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
TS_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -E '\.(ts|tsx)$' || true)

if [ -n "$TS_FILES" ]; then
  echo "🔍 Running incremental typecheck..."
  mkdir -p .cache
  npx --no-install tsc --noEmit --incremental --tsBuildInfoFile .cache/tsconfig.precommit.tsbuildinfo || exit 1
  echo "✅ Typecheck passed"

  echo "🧪 Running tests related to staged TypeScript files..."
  # shellcheck disable=SC2086 -- staged paths are intentionally passed as separate arguments
  npx --no-install vitest related $TS_FILES --run --configLoader runner --reporter dot \
    --exclude 'src/e2e/**' --exclude 'e2e/**' --exclude 'tests/**' \
    --exclude '.mimocode/**' --exclude 'src/shared/tests/integration/**' \
    > .vitest-commit.log 2>&1
  VITEST_EXIT=$?
  tail -15 .vitest-commit.log
  rm -f .vitest-commit.log
  [ $VITEST_EXIT -eq 0 ] || exit $VITEST_EXIT
  echo "✅ Related tests passed"
fi

CODE_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -E '^src/|^backend/' | grep -E '\.(ts|tsx|js|jsx)$' | wc -l | tr -d ' ')
CONTENT_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -E '\.data\.(json|ts)$' | wc -l | tr -d ' ')
if [ "$CODE_FILES" -gt 0 ] && [ "$CONTENT_FILES" -gt 0 ]; then
  echo "⚠️  Mixed commit: $CODE_FILES code file(s), $CONTENT_FILES content file(s). Consider splitting."
fi
