# === Backend Environment Variables ===

# Node
NODE_ENV=production
PORT=10000

# App
APP_ORIGIN=https://eng-vox.vercel.app
APP_VERSION=4.0.22

# AI Provider
AI_PROVIDER=gemini
GEMINI_API_KEY=<Gemini API key from aistudio.google.com>
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=20000
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30

# Supabase
SUPABASE_URL=<https://xxxxx.supabase.co from Supabase Dashboard>
SUPABASE_ANON_KEY=<anon public key from Supabase Dashboard>
SUPABASE_SERVICE_ROLE_KEY=<service_role key - NEVER commit to git>

# Billing - DodoPayments (LIVE)
BILLING_REPOSITORY=supabase
BILLING_PROVIDER=dodo
DODO_PAYMENTS_API_KEY=<Live API key from DodoPayments Dashboard>
DODO_PAYMENTS_WEBHOOK_KEY=<Webhook signing secret from DodoPayments>
DODO_PAYMENTS_ENVIRONMENT=live
DODO_PRODUCT_JUNIOR_MONTHLY=<pdt_id from DodoPayments>
DODO_PRODUCT_JUNIOR_ANNUAL=<pdt_id from DodoPayments>
DODO_PRODUCT_SENIOR_MONTHLY=<pdt_id from DodoPayments>
DODO_PRODUCT_SENIOR_ANNUAL=<pdt_id from DodoPayments>
DODO_PRODUCT_SPECIALIST_MONTHLY=<pdt_id from DodoPayments>
DODO_PRODUCT_SPECIALIST_ANNUAL=<pdt_id from DodoPayments>
DODO_PRODUCT_MASTER_MONTHLY=<pdt_id from DodoPayments>
DODO_PRODUCT_MASTER_ANNUAL=<pdt_id from DodoPayments>
DODO_PRODUCT_TEAM_MONTHLY=<pdt_id from DodoPayments>
DODO_PRODUCT_TEAM_ANNUAL=<pdt_id from DodoPayments>
DODO_PRODUCT_TOPUP=<pdt_id from DodoPayments>

# Rate Limiting
RATE_LIMIT_STORE=upstash
UPSTASH_REDIS_REST_URL=<from Upstash Console>
UPSTASH_REDIS_REST_TOKEN=<from Upstash Console>
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
ALLOW_INSECURE_DEV_AUTH=false

# Auth - Clerk
CLERK_ISSUER=<your-clerk-issuer from Clerk Dashboard>
CLERK_SECRET_KEY=<sk_live_xxx from Clerk Dashboard>

# CORS
CORS_ALLOWED_ORIGINS=https://eng-vox.vercel.app
