PORT=8787
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
APP_VERSION=4.0.22

# AI - Google Gemini
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=20000
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30

# Supabase (database only — auth uses Clerk)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
BILLING_REPOSITORY=supabase

# Billing - Dodo Payments (primary)
BILLING_PROVIDER=dodo
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your-dodo-webhook-key
DODO_PAYMENTS_ENVIRONMENT=test
DODO_PRODUCT_JUNIOR_MONTHLY=pdt_xxx
DODO_PRODUCT_JUNIOR_ANNUAL=pdt_xxx
DODO_PRODUCT_SENIOR_MONTHLY=pdt_xxx
DODO_PRODUCT_SENIOR_ANNUAL=pdt_xxx
DODO_PRODUCT_SPECIALIST_MONTHLY=pdt_xxx
DODO_PRODUCT_SPECIALIST_ANNUAL=pdt_xxx
DODO_PRODUCT_MASTER_MONTHLY=pdt_xxx
DODO_PRODUCT_MASTER_ANNUAL=pdt_xxx
DODO_PRODUCT_TEAM_MONTHLY=pdt_xxx
DODO_PRODUCT_TEAM_ANNUAL=pdt_xxx
DODO_PRODUCT_TOPUP=pdt_xxx

# Billing - Stripe (legacy, kept for migration reference)
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# STRIPE_PRICE_JUNIOR_MONTHLY=price_xxx

# Rate Limiting - Upstash
RATE_LIMIT_STORE=upstash
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Auth - Clerk
ALLOW_INSECURE_DEV_AUTH=false
ENGINEEROS_INTERNAL_API_SECRET=your-internal-api-secret
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_SECRET_KEY=
CLERK_API_URL=https://api.clerk.com
CLERK_TOKEN_FILE=

# Email notifications
EMAIL_TRANSPORT=console
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Storage
SPEAKING_AUDIO_BUCKET=speaking-audio

# Monitoring
SENTRY_DSN=

# Additional AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# JWT
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Billing repository
ALLOW_MEMORY_BILLING_REPOSITORY=false

# Rate limit override
ALLOW_IN_MEMORY_RATE_LIMIT_IN_PRODUCTION=false
RATE_LIMIT_STORE_TIMEOUT_MS=3000

# Vocabulary
VOCABULARY_LOOKUP_TIMEOUT_MS=5000
VOCABULARY_LOOKUP_RATE_LIMIT_MAX=30
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
MYMEMORY_ENABLED=true

# Logging
LOG_LEVEL=info

# Redis (for BullMQ jobs)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
