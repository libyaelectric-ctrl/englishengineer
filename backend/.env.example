PORT=8787
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
APP_VERSION=4.0.22

# AI - Google Gemini
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=20000
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
BILLING_REPOSITORY=supabase

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_JUNIOR_MONTHLY=price_xxx
STRIPE_PRICE_SENIOR_MONTHLY=price_xxx
STRIPE_PRICE_SPECIALIST_MONTHLY=price_xxx
STRIPE_PRICE_MASTER_MONTHLY=price_xxx
STRIPE_EVENT_CACHE_TTL_MS=86400000
STRIPE_EVENT_CACHE_MAX=5000

# Rate Limiting - Upstash
RATE_LIMIT_STORE=upstash
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Auth
ALLOW_INSECURE_DEV_AUTH=false
ENGINEEROS_INTERNAL_API_SECRET=your-internal-api-secret

# Clerk - when set, Bearer Clerk session JWTs authenticate via the instance JWKS
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_SECRET_KEY=
CLERK_API_URL=https://api.clerk.com
# Path to a locally-issued Clerk session token, used only by
# backend/test/live-clerk-verify.test.ts for live integration testing.
CLERK_TOKEN_FILE=

# Alternative billing provider (Dodo Payments)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=

# Email notifications - set EMAIL_TRANSPORT to 'console' | 'smtp' | 'resend' | 'sendgrid'
EMAIL_TRANSPORT=console
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Storage bucket for speaking exercise audio uploads
SPEAKING_AUDIO_BUCKET=speaking-audio

# Monitoring
SENTRY_DSN=

# Additional AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# JWT
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Billing repository
ALLOW_MEMORY_BILLING_REPOSITORY=false

# Rate limit override
ALLOW_IN_MEMORY_RATE_LIMIT_IN_PRODUCTION=false
RATE_LIMIT_STORE_TIMEOUT_MS=3000

# Team is intentionally not enabled for checkout yet.
STRIPE_PRICE_TEAM_MONTHLY=price_xxx

# Vocabulary
VOCABULARY_LOOKUP_TIMEOUT_MS=5000
VOCABULARY_LOOKUP_RATE_LIMIT_MAX=30
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
MYMEMORY_ENABLED=true

# Logging
LOG_LEVEL=info

# Redis (for BullMQ jobs)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
