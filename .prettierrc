{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 100,
  "endOfLine": "auto",
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": [
    "^react$",
    "^react-dom$",
    "^react-router",
    "^@/core/(.*)$",
    "^@/shared/(.*)$",
    "^@/features/(.*)$",
    "^@/layouts/(.*)$",
    "^@/pages/(.*)$",
    "^@/providers/(.*)$",
    "^@/routes/(.*)$",
    "^@/store/(.*)$",
    "^@/config/(.*)$",
    "^@/components/(.*)$",
    "^@/test/(.*)$",
    "^@/bootstrap/(.*)$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
