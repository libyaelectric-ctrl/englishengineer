{
  "$schema": "https://unjs.github.io/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": ["api/translate.js"],
      "ignoreDependencies": ["@testing-library/jest-dom", "lint-staged"]
    },
    "backend": {
      "entry": ["src/app.ts"],
      "ignoreDependencies": ["tsx", "swagger-ui-dist"]
    }
  },
  "ignore": ["src/core/index.ts"],
  "include": ["files", "dependencies"],
  "ignoreFiles": [
    "scripts/**",
    "public/**",
    ".lighthouserc.cjs",
    "tests/**",
    "backend/scripts/**",
    "src/shared/types/analytics.types.ts"
  ]
}
