VITE_APP_VERSION=4.0.22
VITE_ENVIRONMENT_MODE=local
VITE_SITE_URL=https://eng-vox.vercel.app

VITE_AI_PROVIDER=mock
VITE_AI_PROXY_URL=
VITE_BACKEND_URL=

VITE_AUTH_PROVIDER=firebase
VITE_ALLOW_LOCAL_AUTH=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase (the web API key is public by design — security comes from
# Firebase Auth domain restrictions + Security Rules, not key secrecy)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
# Dedicated Firebase test-project account for authenticated Playwright suites
FIREBASE_E2E_TEST_EMAIL=
FIREBASE_E2E_TEST_PASSWORD=
FIREBASE_AUTH_REST_URL=https://identitytoolkit.googleapis.com/v1
VITE_AUTH_SIGN_IN_URL=
VITE_AUTH_SIGN_IN_FALLBACK_REDIRECT_URL=
VITE_AUTH_SIGN_UP_URL=
VITE_AUTH_SIGN_UP_FALLBACK_REDIRECT_URL=

# Translation fallback endpoint used by the Translator feature
VITE_LIBRETRANSLATE_URL=

VITE_BILLING_API_URL=
VITE_ENABLE_MOCK_BILLING=true
VITE_VOCABULARY_API_URL=

VITE_ERROR_MONITORING_PROVIDER=
VITE_SENTRY_DSN=
VITE_ERROR_MONITORING_SAMPLE_RATE=0

# Privacy-safe product funnel analytics. Set enabled=false to disable all events.
VITE_PRODUCT_ANALYTICS_ENABLED=true
VITE_PRODUCT_ANALYTICS_PROVIDER=local

# Stripe (for billing)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key  (unused, Firebase handles auth)

# Logging
VITE_LOG_LEVEL=info

# --- Root-level scripts (e.g. scripts/prc-kademe-8-live-verify.mjs) ---
# These are consumed by Node scripts at the repo root, not by the Vite app.
AI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Build / dev flags (consumed by vite.config.ts)
ANALYZE=false
DISABLE_HMR=false

# CI / verification scripts (scripts/prc-kademe-8-live-verify.mjs, scripts/grammar-review-bot.js)
GITHUB_ACTIONS=false
SANDBOX=false
GITHUB_TOKEN=
PR_BODY=
PR_NUMBER=
PR_TITLE=
REPOSITORY=

# Used by tests/browser/*.spec.ts to target a running backend
BACKEND_URL=http://localhost:8787

# Backend: protects GET /api/metrics and GET /api/diagnostics.
# Required in production; requests must send the token via
# `Authorization: Bearer <token>` or `?token=`.
METRICS_TOKEN=

# Frontend: optional CDN base for runtime data files (vocabulary seeds,
# translation corpora). When set, loaders fetch <CDN>/data/... instead of
# same-origin /data/*. Upload the files with
# scripts/upload-data-to-storage.mjs first.
VITE_DATA_CDN_URL=https://<your-project>.supabase.co/storage/v1/object/public/app-data

# --- Supabase Backend Keys ---
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

# --- PostgreSQL ---
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=

# --- Backend Extras ---
APP_URL=
RENDER_EXTERNAL_URL=
CORS_ALLOWED_ORIGINS=
AI_LEDGER_FILE=

# Phase 5 hardened backend authentication
ENGINEEROS_INTERNAL_SERVICE_ID=
ENGINEEROS_INTERNAL_SERVICE_EMAIL=
ENGINEEROS_INTERNAL_SERVICE_ROLE=service
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
